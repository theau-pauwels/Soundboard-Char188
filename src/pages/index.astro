---
const sounds = [
  ['???', 'Scooby', '[Bleusi] ??? (Scooby).m4a'],
  ['A droite comme Lhote', 'Scooby', '[Bleusi] A droite comme Lhote (Scooby).m4a'],
  ['A gauche comme Rogge', 'Samy', '[Bleusi] A gauche comme Rogge (Samy).m4a'],
  ['A gauche comme Rogge', 'Scooby', '[Bleusi] A gauche comme Rogge (Scooby).m4a'],
  ['Bouuuuuh', 'Samy & Scooby', '[Bleusi] Bouuuuuh (Samy & Scooby).m4a'],
  ['Dans l’axe', 'Samy', '[Bleusi] Dans l’axe (Samy).m4a'],
  ['Dans l’axe', 'Scooby', '[Bleusi] Dans l’axe (Scooby).m4a'],
  ['Devant et à gauche le sol', 'Scooby', '[Bleusi] Devant et a gauche le sol (Scooby).m4a'],
  ['Gloire aux bourreaux', 'Samy', '[Bleusi] Gloire aux bourreaux (Samy).m4a'],
  ['Hey les bleus, gloire aux bourreaux', 'Samy', '[Bleusi] Hey les bleus gloire aux bourreaux (Samy).m4a'],
  ['Hey les bleus, regardez vos pieds', 'Samy', '[Bleusi] Hey les bleus regardez vos pieds (Samy).m4a'],
  ['Huez-vous les bleus', 'Scooby', '[Bleusi] Huez vous les bleus (Scooby).m4a'],
  ['On regarde le sol', 'Scooby', '[Bleusi] On regarde le sol (Scooby).m4a'],
  ['Plus fort', 'Samy', '[Bleusi] Plus fort (Samy).m4a'],
  ['Plus fort', 'Scooby', '[Bleusi] Plus fort (Scooby).m4a'],
  ['Scooby Snack', 'Scooby', '[Bleusi] Scooby Snack.m4a'],
  ['Stop les bleus', 'Scooby', '[Bleusi] Stop les bleus (Scooby).m4a'],
  ['Vous êtes à chier les bleus', 'Scooby', '[Bleusi] Vous etes a chier les bleus (Scooby).m4a'],
].map(([title, voice, file], index) => ({
  id: index + 1,
  title,
  voice,
  file,
  url: `https://raw.githubusercontent.com/theau-pauwels/Soundboard-Char188/main/${encodeURIComponent(file).replace(/%2F/g, '/')}`,
}));

const voices = ['Tous', 'Samy', 'Scooby', 'Samy & Scooby'];
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#111827" />
    <meta name="description" content="Soundboard Char 188 — les meilleures voicelines du char." />
    <title>Soundboard Char 188</title>
    <style>
      :root { font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color: #f8fafc; background: #070b14; }
      * { box-sizing: border-box; }
      body { margin: 0; min-height: 100vh; background: radial-gradient(circle at top, #172033 0, #0b1120 36%, #070b14 72%); }
      button, input { font: inherit; }
      .shell { width: min(1180px, calc(100% - 32px)); margin: 0 auto; padding: 54px 0 70px; }
      header { display: flex; align-items: end; justify-content: space-between; gap: 24px; margin-bottom: 34px; }
      .eyebrow { margin: 0 0 7px; color: #fbbf24; font-size: .78rem; font-weight: 800; letter-spacing: .18em; text-transform: uppercase; }
      h1 { margin: 0; font-size: clamp(2.3rem, 7vw, 5rem); line-height: .9; letter-spacing: -.055em; }
      .subtitle { max-width: 520px; margin: 14px 0 0; color: #94a3b8; font-size: 1rem; }
      .header-actions { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; justify-content: flex-end; }
      .gain-control { display: flex; align-items: center; gap: 10px; border: 1px solid #ffffff16; background: #ffffff08; padding: 10px 13px; border-radius: 14px; color: #cbd5e1; font-size: .82rem; font-weight: 700; }
      .gain-control input { width: 110px; accent-color: #fbbf24; }
      .gain-value { min-width: 38px; color: #fbbf24; text-align: right; }
      .stop { border: 1px solid #ef444466; background: #ef444414; color: #fecaca; padding: 12px 16px; border-radius: 14px; cursor: pointer; font-weight: 750; }
      .toolbar { display: grid; grid-template-columns: minmax(220px, 1fr) auto; gap: 14px; margin-bottom: 24px; }
      .search { width: 100%; border: 1px solid #ffffff18; background: #ffffff0a; color: #fff; outline: none; padding: 14px 16px; border-radius: 15px; }
      .search:focus { border-color: #fbbf2477; box-shadow: 0 0 0 3px #fbbf2412; }
      .filters { display: flex; flex-wrap: wrap; gap: 8px; }
      .filter { border: 1px solid #ffffff16; background: #ffffff08; color: #cbd5e1; padding: 10px 13px; border-radius: 999px; cursor: pointer; }
      .filter.active { background: #fbbf24; border-color: #fbbf24; color: #111827; font-weight: 800; }
      .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
      .pad { position: relative; min-height: 154px; overflow: hidden; text-align: left; border: 1px solid #ffffff14; border-radius: 20px; background: linear-gradient(145deg, #ffffff0c, #ffffff04); color: #f8fafc; padding: 19px; cursor: pointer; transition: transform .12s ease, border-color .12s ease, background .12s ease; box-shadow: 0 12px 34px #00000022; }
      .pad:hover { transform: translateY(-2px); border-color: #fbbf2455; background: linear-gradient(145deg, #ffffff12, #ffffff06); }
      .pad:active, .pad.playing { transform: scale(.985); border-color: #fbbf24aa; background: #fbbf2410; }
      .number { color: #64748b; font-size: .74rem; font-weight: 800; letter-spacing: .1em; }
      .title { display: block; margin-top: 26px; font-size: 1.14rem; font-weight: 800; line-height: 1.18; }
      .voice { display: block; position: absolute; bottom: 17px; left: 19px; color: #fbbf24; font-size: .78rem; font-weight: 700; }
      .icon { position: absolute; right: 17px; bottom: 15px; width: 34px; height: 34px; display: grid; place-items: center; border-radius: 50%; background: #ffffff0c; color: #cbd5e1; }
      .empty { display: none; color: #94a3b8; padding: 40px 0; text-align: center; }
      footer { margin-top: 28px; color: #475569; font-size: .8rem; text-align: center; }
      @media (max-width: 820px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .toolbar { grid-template-columns: 1fr; } header { align-items: start; } }
      @media (max-width: 520px) { .shell { width: min(100% - 22px, 1180px); padding-top: 32px; } header { flex-direction: column; } .header-actions { width: 100%; justify-content: stretch; } .gain-control { flex: 1; } .gain-control input { flex: 1; min-width: 80px; } .stop { width: 100%; } .grid { grid-template-columns: 1fr 1fr; gap: 9px; } .pad { min-height: 140px; padding: 14px; border-radius: 16px; } .title { margin-top: 22px; font-size: .96rem; } .voice { left: 14px; bottom: 13px; } .icon { right: 12px; bottom: 10px; } }
    </style>
  </head>
  <body>
    <main class="shell">
      <header>
        <div>
          <p class="eyebrow">Char 188</p>
          <h1>Soundboard</h1>
          <p class="subtitle">Les voicelines du char, prêtes à être lancées au bon — ou au pire — moment.</p>
        </div>
        <div class="header-actions">
          <label class="gain-control" for="gain">
            Gain
            <input id="gain" type="range" min="0.5" max="3" step="0.1" value="1" />
            <span class="gain-value" id="gain-value">1.0×</span>
          </label>
          <button class="stop" id="stop-all" type="button">■ Tout arrêter</button>
        </div>
      </header>

      <section class="toolbar" aria-label="Filtres">
        <input class="search" id="search" type="search" placeholder="Rechercher une voiceline…" autocomplete="off" />
        <div class="filters">
          {voices.map((voice) => <button class:list={['filter', { active: voice === 'Tous' }]} data-filter={voice} type="button">{voice}</button>)}
        </div>
      </section>

      <section class="grid" id="sound-grid">
        {sounds.map((sound) => (
          <button class="pad" type="button" data-title={sound.title.toLowerCase()} data-voice={sound.voice} data-url={sound.url}>
            <span class="number">{String(sound.id).padStart(2, '0')}</span>
            <span class="title">{sound.title}</span>
            <span class="voice">{sound.voice}</span>
            <span class="icon" aria-hidden="true">▶</span>
          </button>
        ))}
      </section>
      <p class="empty" id="empty">Aucune voiceline ne correspond à cette recherche.</p>
      <footer>Char 188 · Bleusi Soundboard</footer>
    </main>

    <script>
      const pads = [...document.querySelectorAll('.pad')];
      const filters = [...document.querySelectorAll('.filter')];
      const search = document.querySelector('#search');
      const stopAll = document.querySelector('#stop-all');
      const empty = document.querySelector('#empty');
      const gainInput = document.querySelector('#gain');
      const gainValue = document.querySelector('#gain-value');
      const audioByUrl = new Map();
      let audioContext = null;
      let gainNode = null;
      const connectedAudio = new WeakSet();

      function ensureAudioGraph(audio) {
        if (!audioContext) {
          audioContext = new AudioContext();
          gainNode = audioContext.createGain();
          gainNode.gain.value = Number(gainInput.value);
          gainNode.connect(audioContext.destination);
        }

        if (!connectedAudio.has(audio)) {
          const source = audioContext.createMediaElementSource(audio);
          source.connect(gainNode);
          connectedAudio.add(audio);
        }

        if (audioContext.state === 'suspended') audioContext.resume();
      }

      pads.forEach((pad) => {
        const audio = new Audio();
        audio.preload = 'auto';
        audio.src = pad.dataset.url;
        audio.load();
        audioByUrl.set(pad.dataset.url, audio);
      });

      let currentAudio = null;
      let currentPad = null;
      let activeFilter = 'Tous';

      function resetCurrent() {
        currentPad?.classList.remove('playing');
        const icon = currentPad?.querySelector('.icon');
        if (icon) icon.textContent = '▶';
        currentAudio = null;
        currentPad = null;
      }

      function stopAudio() {
        if (currentAudio) {
          currentAudio.pause();
          currentAudio.currentTime = 0;
        }
        resetCurrent();
      }

      function applyFilters() {
        const query = search.value.trim().toLowerCase();
        let visible = 0;
        pads.forEach((pad) => {
          const matchesVoice = activeFilter === 'Tous' || pad.dataset.voice === activeFilter;
          const matchesSearch = !query || pad.dataset.title.includes(query) || pad.dataset.voice.toLowerCase().includes(query);
          const show = matchesVoice && matchesSearch;
          pad.hidden = !show;
          if (show) visible++;
        });
        empty.style.display = visible ? 'none' : 'block';
      }

      pads.forEach((pad) => pad.addEventListener('click', () => {
        const wasCurrent = pad === currentPad;
        stopAudio();
        if (wasCurrent) return;

        const audio = audioByUrl.get(pad.dataset.url);
        if (!audio) return;
        ensureAudioGraph(audio);
        audio.currentTime = 0;
        currentAudio = audio;
        currentPad = pad;
        pad.classList.add('playing');
        pad.querySelector('.icon').textContent = '■';
        audio.addEventListener('ended', resetCurrent, { once: true });
        audio.addEventListener('error', resetCurrent, { once: true });
        audio.play().catch(resetCurrent);
      }));

      filters.forEach((filter) => filter.addEventListener('click', () => {
        activeFilter = filter.dataset.filter;
        filters.forEach((item) => item.classList.toggle('active', item === filter));
        applyFilters();
      }));

      gainInput.addEventListener('input', () => {
        const gain = Number(gainInput.value);
        gainValue.textContent = `${gain.toFixed(1)}×`;
        if (gainNode) gainNode.gain.value = gain;
      });

      search.addEventListener('input', applyFilters);
      stopAll.addEventListener('click', stopAudio);
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') stopAudio();
      });
    </script>
  </body>
</html>
